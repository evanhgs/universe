# always add and write contents at the end of file
COMPOSE_PROJECT_NAME=universe-dev
APP_ENV=development

APP_URL=http://localhost:3000
AI_SERVICES_URL=http://localhost:8000
AI_SERVICES_ALLOWED_ORIGINS=http://localhost:3000
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
S3_PUBLIC_ENDPOINT=http://replace_with_host_lan_ip:9000

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_TELEMETRY_DISABLED=0

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX_ENABLED=false

CRON_SECRET=replace_me
CRON_ALLOWED_IPS=127.0.0.1,::1

NEXTJS_CONTEXT=../app
NEXTJS_DOCKERFILE=../app/Dockerfile
NEXTJS_NODE_ENV=development
NEXTJS_HOSTNAME=0.0.0.0
NEXTJS_PORT=3000
NEXTJS_TELEMETRY_DISABLED=0
NEXTJS_WATCHPACK_POLLING=true
DATABASE_URL=postgresql://universe:universe_dev_password@postgres:5432/universe_dev?schema=public

POSTGRES_DB=universe_dev
POSTGRES_USER=universe
POSTGRES_PASSWORD=universe_dev_password

AI_SERVICES_CONTEXT=../ai-services
AI_SERVICES_DOCKERFILE=../ai-services/Dockerfile
AI_SERVICES_PORT=8000
AI_SERVICES_PYTHONDONTWRITEBYTECODE=1
# Leave empty in dev only if you accept that all endpoints (except /health)
# return 503; nextjs must send this same value when calling the service.
AI_SERVICES_PYTHONUNBUFFERED=1
AI_SERVICES_API_KEY=replace_me_dev

S3_REGION=us-east-1
S3_BUCKET_BEATS=universe-dev-beats
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=true

AUDIO_WORKER_CONTEXT=../audio-worker
AUDIO_WORKER_DOCKERFILE=../audio-worker/Dockerfile
AUDIO_WORKER_POLL_INTERVAL_MS=2000
AUDIO_WORKER_RUST_LOG=info

REDIS_HOST_PORT=6379
REDIS_PASSWORD=replace_me_dev_redis_password
REDIS_URL=redis://:replace_me_dev_redis_password@redis:6379

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=
SENTRY_ORG=universe-a4
SENTRY_PROJECT=universe-nextjs
SENTRY_RELEASE=

RESEND_API_KEY=
RESEND_EMAIL_FROM=no-reply@example.com

SEED_BEAT_COUNT=500
SEED_SELLER_COUNT=40
SEED_ANALYTICS_EVENTS=50000
SEED_BUYER_COUNT=8
SEED_RANDOM_SEED=20260605
SEED_AUDIO_BUCKET=universe-dev-beats
SEED_AUDIO_OBJECT_KEY=beats/preview/replace_with_existing_preview_owner_id/replace_with_existing_preview.mp3

# REDIS rate limits
REDIS_API_GLOBAL=1000
REDIS_ACCOUNT_WRITE=200
REDIS_STORAGE_PRESIGN=30
REDIS_MARKETPLACE_WRITE=300
REDIS_MARKETPLACE_READ=5000
REDIS_ANALYTICS_WRITE=2000
REDIS_CHAT_WRITE=100
REDIS_CHAT_READ=3000
REDIS_PUBLIC_ENUMERATION=1000
REDIS_ACCOUNT_TEST_BURST=8