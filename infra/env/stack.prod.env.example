COMPOSE_PROJECT_NAME=universe-prod
APP_ENV=production

APP_URL=https://universe.evanhgs.fr
AI_SERVICES_URL=
AI_SERVICES_ALLOWED_ORIGINS=https://universe.evanhgs.fr
CLERK_AUTHORIZED_PARTIES=https://universe.evanhgs.fr
S3_PUBLIC_ENDPOINT=https://stockage.evanhgs.fr

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_TELEMETRY_DISABLED=0
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_AUTOMATIC_TAX_ENABLED=false

CRON_SECRET=replace_me
CRON_ALLOWED_IPS=replace_with_scheduler_ip_or_cidr

NEXTJS_CONTEXT=../app
NEXTJS_DOCKERFILE=../app/Dockerfile
NEXTJS_IMAGE=universe/nextjs
NEXTJS_IMAGE_TAG=prod
NEXTJS_NODE_ENV=production
NEXTJS_HOSTNAME=0.0.0.0
NEXTJS_PORT=3000
NEXTJS_TELEMETRY_DISABLED=0
NEXTJS_PROXY_HTTP_PORT=8080
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_base64_aes_key
DATABASE_URL=postgresql://universe:replace_me_db_password@postgres:5432/universe_production?schema=public

POSTGRES_DB=universe_prod
POSTGRES_USER=universe
POSTGRES_PASSWORD=replace_me_db_password

AI_SERVICES_CONTEXT=../ai-services
AI_SERVICES_DOCKERFILE=../ai-services/Dockerfile
AI_SERVICES_IMAGE=universe/ai-services
AI_SERVICES_IMAGE_TAG=prod
AI_SERVICES_PORT=8000
AI_SERVICES_PYTHONDONTWRITEBYTECODE=1
AI_SERVICES_PYTHONUNBUFFERED=1
AI_SERVICES_API_KEY=replace_me

S3_REGION=us-east-1
S3_BUCKET_BEATS=universe-production-beats
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=true

AUDIO_WORKER_CONTEXT=../audio-worker
AUDIO_WORKER_DOCKERFILE=../audio-worker/Dockerfile
AUDIO_WORKER_IMAGE=universe/audio-worker
AUDIO_WORKER_IMAGE_TAG=prod
AUDIO_WORKER_ID=prod-audio-worker-1
AUDIO_WORKER_POLL_INTERVAL_MS=2000
AUDIO_WORKER_TMP_DIR=/tmp/universe-audio-worker
AUDIO_WORKER_TMPFS_SIZE=1g
AUDIO_WORKER_RUST_LOG=info

REDIS_PASSWORD=replace_me_redis_password
REDIS_URL=redis://:replace_me_redis_password@redis:6379

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=
SENTRY_ORG=universe-a4
SENTRY_PROJECT=universe-nextjs
SENTRY_RELEASE=

RESEND_API_KEY=replace_me
RESEND_EMAIL_FROM=no-reply@production.example.com

SEED_BEAT_COUNT=500
SEED_SELLER_COUNT=40
SEED_ANALYTICS_EVENTS=50000
SEED_BUYER_COUNT=8
SEED_RANDOM_SEED=20260605
SEED_AUDIO_BUCKET=universe-production-beats
SEED_AUDIO_OBJECT_KEY=beats/preview/replace_with_existing_preview_owner_id/replace_with_existing_preview.mp3
