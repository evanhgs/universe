COMPOSE_PROJECT_NAME=universe-prod
APP_ENV=production
APP_URL=https://example.com
AI_SERVICES_URL=https://api.example.com
CLERK_AUTHORIZED_PARTIES=https://example.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=

STRIPE_AUTOMATIC_TAX_ENABLED=false

NEXTJS_CONTEXT=../app
NEXTJS_DOCKERFILE=../app/Dockerfile
NEXTJS_IMAGE=universe/nextjs
NEXTJS_IMAGE_TAG=prod
NEXTJS_NODE_ENV=production
NEXTJS_HOSTNAME=0.0.0.0
NEXTJS_PORT=3000
NEXTJS_TELEMETRY_DISABLED=1
NEXTJS_PROXY_HTTP_PORT=80
NEXTJS_PROXY_HTTPS_PORT=443

CADDY_HOSTNAME=example.com
CADDY_EMAIL=ops@example.com

AI_SERVICES_CONTEXT=../ai-services
AI_SERVICES_DOCKERFILE=../ai-services/Dockerfile
AI_SERVICES_IMAGE=universe/ai-services
AI_SERVICES_IMAGE_TAG=prod
AI_SERVICES_PORT=8000
AI_SERVICES_PYTHONDONTWRITEBYTECODE=1
AI_SERVICES_PYTHONUNBUFFERED=1
AI_SERVICES_PROXY_HTTP_PORT=8011
AI_SERVICES_PROXY_HTTPS_PORT=8444
AI_SERVICES_CADDY_HOSTNAME=api.example.com
AI_SERVICES_CADDY_EMAIL=ops@example.com
