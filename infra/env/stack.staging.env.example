# =============================================================================
# UNIVERSE - STAGING ENVIRONMENT
# =============================================================================
# Environment: Staging
# WARNING:
# - Never commit real secrets
# - Replace all placeholder values before deployment
# - Add new variables at the end of the relevant section
# =============================================================================

COMPOSE_PROJECT_NAME=universe-staging
APP_ENV=staging


# =============================================================================
# APPLICATION
# =============================================================================

APP_URL=https://universe.evanhgs.fr

AI_SERVICES_URL=
AI_SERVICES_ALLOWED_ORIGINS=https://universe.evanhgs.fr

CLERK_AUTHORIZED_PARTIES=https://universe.evanhgs.fr

S3_PUBLIC_ENDPOINT=https://stockage.evanhgs.fr


# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Enable (1) / Disable (0) Clerk telemetry
CLERK_TELEMETRY_DISABLED=0


# =============================================================================
# STRIPE
# =============================================================================

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_UNIVERSE_MONTHLY_PRICE_ID=price_replace_me
UNIVERSE_PRICING_MONTHLY_LABEL=8,99 €/mois

# Enable automatic tax calculation
STRIPE_AUTOMATIC_TAX_ENABLED=false


# =============================================================================
# CRON / SCHEDULER
# =============================================================================

CRON_SECRET=replace_me

# Scheduler IP or CIDR allowed to trigger cron routes
CRON_ALLOWED_IPS=replace_with_scheduler_ip_or_cidr


# =============================================================================
# DATABASE - POSTGRESQL
# =============================================================================

POSTGRES_DB=universe_staging
POSTGRES_USER=universe
POSTGRES_PASSWORD=replace_me_db_password

DATABASE_URL=postgresql://universe:replace_me_db_password@postgres:5432/universe_staging?schema=public


# =============================================================================
# REDIS
# =============================================================================

REDIS_PASSWORD=replace_me_redis_password
REDIS_URL=redis://:replace_me_redis_password@redis:6379
REDIS_HOST_PORT=6379


# =============================================================================
# REDIS RATE LIMITS
# =============================================================================

REDIS_API_GLOBAL=1000

REDIS_ACCOUNT_WRITE=200
REDIS_ACCOUNT_TEST_BURST=8

REDIS_STORAGE_PRESIGN=30

REDIS_MARKETPLACE_WRITE=300
REDIS_MARKETPLACE_READ=5000

REDIS_ANALYTICS_WRITE=2000

REDIS_CHAT_WRITE=100
REDIS_CHAT_READ=3000

REDIS_PUBLIC_ENUMERATION=1000


# =============================================================================
# NEXT.JS APPLICATION
# =============================================================================

NEXTJS_CONTEXT=../app
NEXTJS_DOCKERFILE=../app/Dockerfile

NEXTJS_IMAGE=universe/nextjs
NEXTJS_IMAGE_TAG=staging

NEXTJS_NODE_ENV=production

NEXTJS_HOSTNAME=0.0.0.0
NEXTJS_PORT=3000
NEXTJS_PROXY_HTTP_PORT=3050

# AES encryption key used by Server Actions
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_base64_aes_key

# Enable (1) / Disable (0) Next.js telemetry
NEXTJS_TELEMETRY_DISABLED=0

# Enable polling for Docker-mounted volumes
NEXTJS_WATCHPACK_POLLING=true


# =============================================================================
# AI SERVICES (FASTAPI)
# =============================================================================

AI_SERVICES_CONTEXT=../ai-services
AI_SERVICES_DOCKERFILE=../ai-services/Dockerfile

AI_SERVICES_IMAGE=universe/ai-services
AI_SERVICES_IMAGE_TAG=staging

AI_SERVICES_PORT=8000

AI_SERVICES_API_KEY=replace_me

AI_SERVICES_PYTHONDONTWRITEBYTECODE=1
AI_SERVICES_PYTHONUNBUFFERED=1


# =============================================================================
# AUDIO WORKER (RUST)
# =============================================================================

AUDIO_WORKER_CONTEXT=../audio-worker
AUDIO_WORKER_DOCKERFILE=../audio-worker/Dockerfile

AUDIO_WORKER_IMAGE=universe/audio-worker
AUDIO_WORKER_IMAGE_TAG=staging

AUDIO_WORKER_ID=staging-audio-worker-1

# Polling interval (milliseconds)
AUDIO_WORKER_POLL_INTERVAL_MS=2000

# Temporary processing directory
AUDIO_WORKER_TMP_DIR=/tmp/universe-audio-worker

# Temporary filesystem size
AUDIO_WORKER_TMPFS_SIZE=1g

# Rust log level
AUDIO_WORKER_RUST_LOG=info


# =============================================================================
# S3 STORAGE
# =============================================================================

S3_REGION=us-east-1

S3_BUCKET_BEATS=universe-staging-beats

S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me

# Required for many self-hosted S3-compatible providers
S3_FORCE_PATH_STYLE=true


# =============================================================================
# SENTRY
# =============================================================================

NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

SENTRY_AUTH_TOKEN=

SENTRY_ORG=universe-a4
SENTRY_PROJECT=universe-nextjs
SENTRY_RELEASE=


# =============================================================================
# EMAILS (RESEND)
# =============================================================================

RESEND_API_KEY=replace_me

# Sender address
RESEND_EMAIL_FROM=no-reply@staging.example.com


# =============================================================================
# SEEDING / DEVELOPMENT DATA
# =============================================================================

SEED_RANDOM_SEED=20260605

SEED_BEAT_COUNT=500
SEED_SELLER_COUNT=40
SEED_BUYER_COUNT=8

SEED_ANALYTICS_EVENTS=50000

SEED_AUDIO_BUCKET=universe-staging-beats

SEED_AUDIO_OBJECT_KEY=beats/preview/replace_with_existing_preview_owner_id/replace_with_existing_preview.mp3
