COMPOSE_PROJECT_NAME=universe-staging
APP_ENV=staging

APP_URL=http://staging.example.com
AI_SERVICES_URL=
CLERK_AUTHORIZED_PARTIES=http://staging.example.com
CLERK_PROXY_DEBUG=0
S3_PUBLIC_ENDPOINT=https://s3-staging.example.com

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_AUTOMATIC_TAX_ENABLED=false

POSTMARK_SERVER_TOKEN=replace_me
POSTMARK_FROM_EMAIL=no-reply@staging.example.com
CRON_SECRET=replace_me

NEXTJS_CONTEXT=../app
NEXTJS_DOCKERFILE=../app/Dockerfile
NEXTJS_IMAGE=universe/nextjs
NEXTJS_IMAGE_TAG=staging
NEXTJS_NODE_ENV=production
NEXTJS_HOSTNAME=0.0.0.0
NEXTJS_PORT=3000
NEXTJS_TELEMETRY_DISABLED=1
NEXTJS_PROXY_HTTP_PORT=8080
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_base64_aes_key
DATABASE_URL=postgresql://universe:replace_me_db_password@postgres:5432/universe_staging?schema=public

POSTGRES_DB=universe_staging
POSTGRES_USER=universe
POSTGRES_PASSWORD=replace_me_db_password

AI_SERVICES_CONTEXT=../ai-services
AI_SERVICES_DOCKERFILE=../ai-services/Dockerfile
AI_SERVICES_IMAGE=universe/ai-services
AI_SERVICES_IMAGE_TAG=staging
AI_SERVICES_PORT=8000
AI_SERVICES_PYTHONDONTWRITEBYTECODE=1
AI_SERVICES_PYTHONUNBUFFERED=1

S3_REGION=us-east-1
S3_BUCKET_BEATS=universe-staging-beats
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
S3_FORCE_PATH_STYLE=true

AUDIO_WORKER_CONTEXT=../audio-worker
AUDIO_WORKER_DOCKERFILE=../audio-worker/Dockerfile
AUDIO_WORKER_IMAGE=universe/audio-worker
AUDIO_WORKER_IMAGE_TAG=staging
AUDIO_WORKER_ID=staging-audio-worker-1
AUDIO_WORKER_POLL_INTERVAL_MS=2000
AUDIO_WORKER_TMP_DIR=/tmp/universe-audio-worker
AUDIO_WORKER_TMPFS_SIZE=1g
AUDIO_WORKER_RUST_LOG=info
